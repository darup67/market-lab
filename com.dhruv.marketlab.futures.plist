<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.dhruv.marketlab.futures</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/dhruvpatel/.local/bin/node</string>
    <string>/Users/dhruvpatel/market-lab/record-futures.js</string>
  </array>
  <!-- Bars are 15 min and Yahoo keeps ~5 days of them, so a 30-minute tick has
       enormous margin: a full day of failures still recovers on the next
       success. Less frequent than the Kalshi recorder because that data ages
       out in 2 days, this in 5. -->
  <key>StartInterval</key><integer>1800</integer>
  <key>RunAtLoad</key><true/>
  <!-- launchd omits /usr/local/bin, without which git cannot find its keychain
       credential helper and every push fails auth. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/dhruvpatel/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>WorkingDirectory</key><string>/Users/dhruvpatel/market-lab</string>
  <key>StandardOutPath</key><string>/Users/dhruvpatel/market-lab/futures.out.log</string>
  <key>StandardErrorPath</key><string>/Users/dhruvpatel/market-lab/futures.err.log</string>
</dict>
</plist>
